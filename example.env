GOOGLE_API_KEY=
ANALYTICS_API_KEY=

# PostgreSQL Settings
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=app

# -------------------------------------------------------------------
# WebRTC Voice Agent Settings
# -------------------------------------------------------------------
# Google's public STUN server.
STUN_URLS=stun:stun.l.google.com:19302

# Your self-hosted TURN server.
# Replace YOUR_SERVER_PUBLIC_IP with the same IP you used
# in your turnserver.conf file.
TURN_URLS=turn:YOUR_SERVER_PUBLIC_IP:3478?transport=udp,turns:YOUR_SERVER_PUBLIC_IP:5349?transport=tcp

# The username and password for your TURN server.
# These must match what you set in turnserver.conf.
TURN_USERNAME=your_turn_username
TURN_PASSWORD=your_turn_password